{
  "name": "summitapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts capacitor.config.ts",
    "format:check": "prettier --check package.json eslint.config.js vitest.config.ts \"docs/rewrite/**/*.md\" \"src/data/legacy/**/*.ts\" \"src/test/**/*.{ts,tsx}\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^5.1.0",
    "@capacitor/android": "^5.4.1",
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.4.1",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/splash-screen": "^5.0.6",
    "@fontsource/poppins": "^5.3.0",
    "@formkit/auto-animate": "^0.7.0",
    "@fortawesome/fontawesome-svg-core": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@lexical/link": "0.22.0",
    "@lexical/react": "0.22.0",
    "dexie": "^3.2.3",
    "dexie-react-hooks": "^1.1.3",
    "firebase": "^10.4.0",
    "framer-motion": "^10.16.4",
    "lexical": "0.22.0",
    "linkify-it": "5.0.0",
    "markdown-it": "14.1.0",
    "nanoid": "^5.0.1",
    "papaparse": "^5.7.0",
    "react": "^18.2.0",
    "react-collapse": "^5.1.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-intersection-observer": "^9.5.2",
    "react-linkify-it": "^1.0.8",
    "react-minimal-pie-chart": "^8.4.0",
    "react-portal": "^4.2.2",
    "react-router-dom": "^6.15.0",
    "react-swipe-to-reveal-actions": "^1.1.1",
    "react-textarea-autosize": "^8.5.3",
    "react-tiny-popover": "^8.1.6",
    "use-long-press": "^3.1.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.1",
    "@capacitor/cli": "^5.4.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/linkify-it": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.21",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^4.1.0",
    "vite-plugin-pwa": "^1.3.0",
